# Copy this file to .env and adjust values as needed.
# If NVIDIA_API_KEY is unset, src/config.js falls back to the baked-in key
# so the app works zero-config on a fresh Replit import.
NVIDIA_API_KEY=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

# Default model on NVIDIA NIM. Override via env if you want a different one.
NVIDIA_MODEL=qwen/qwen3-coder-480b-a35b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-4-maverick-17b-128e-instruct

# Random secret for signing session cookies. A random one is generated at
# startup if this is unset, but sessions then drop on every restart.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server binds to. Replit injects PORT automatically.
PORT=3000
